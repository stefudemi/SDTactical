<% content_for :title, "Administración | SDTactical" %>

<section class="admin-shell">
  <div class="container">
    <div class="admin-header">
      <div>
        <p class="eyebrow">Back-office</p>
        <h1>Panel de administración</h1>
        <p>Resumen general de SDTactical.</p>
      </div>
    </div>

    <div class="admin-grid">
      <%= link_to admin_products_path, class: "admin-stat" do %><span>Productos</span><strong><%= @product_count %></strong><% end %>
      <%= link_to admin_categories_path, class: "admin-stat" do %><span>Categorías</span><strong><%= @category_count %></strong><% end %>
      <%= link_to admin_orders_path, class: "admin-stat" do %><span>Pedidos</span><strong><%= @order_count %></strong><% end %>
      <%= link_to admin_users_path, class: "admin-stat" do %><span>Usuarios</span><strong><%= @user_count %></strong><% end %>
    </div>
  </div>
</section>
