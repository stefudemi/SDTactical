<section class="admin-shell"><div class="container"><div class="admin-header"><div><p class="eyebrow">Pedido #<%= @order.id %></p><h1>Editar estado</h1></div></div><div class="admin-card"><%= form_with model: [:admin, @order], class: "admin-form" do |form| %><div class="admin-field"><%= form.label :status, "Estado" %><%= form.select :status, @statuses %></div><div class="admin-form-actions"><%= form.submit "Actualizar estado", class: "btn btn-primary" %><%= link_to "Cancelar", admin_order_path(@order), class: "btn btn-secondary" %></div><% end %></div></div></section>
