<section class="admin-shell">
  <div class="container">
    <div class="admin-header">
      <div>
        <p class="eyebrow">Pedido #<%= @order.id %></p>
        <h1>Detalle del pedido</h1>
      </div>

      <div class="admin-actions">
        <%= link_to "Volver", admin_orders_path, class: "btn btn-secondary" %>
      </div>
    </div>

    <article class="admin-card">
      <dl class="admin-details">
        <dt>Usuario</dt>
        <dd><%= @order.user.name.presence || @order.user.email %></dd>

        <dt>Fecha</dt>
        <dd><%= l(@order.created_at, format: :long) %></dd>

        <dt>Estado</dt>
        <dd><%= @order.status.presence || "—" %></dd>

        <dt>Total</dt>
        <dd><%= number_to_currency(@order.total, unit: "$", separator: ",", delimiter: ".") %></dd>
      </dl>
    </article>

    <article class="admin-card">
      <h2>Actualizar estado</h2>

      <%= form_with model: [:admin, @order], class: "admin-form" do |form| %>
        <div class="admin-field">
          <%= form.label :status, "Estado" %>
          <%= form.select :status,
                          [
                            ["Pendiente", "pending"],
                            ["En proceso", "processing"],
                            ["Enviado", "shipped"],
                            ["Completado", "completed"],
                            ["Cancelado", "cancelled"]
                          ] %>
        </div>

        <div class="admin-form-actions">
          <%= form.submit "Actualizar estado", class: "btn btn-primary" %>
        </div>
      <% end %>
    </article>

    <article class="admin-card">
      <h2>Productos</h2>

      <% if @order_items.any? %>
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Producto</th>
                <th>Cantidad</th>
                <th>Precio unitario</th>
              </tr>
            </thead>

            <tbody>
              <% @order_items.each do |item| %>
                <tr>
                  <td><%= link_to item.product.name, admin_product_path(item.product) %></td>
                  <td><%= item.quantity %></td>
                  <td><%= number_to_currency(item.unit_price, unit: "$", separator: ",", delimiter: ".") %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="empty-state">Este pedido no tiene artículos.</p>
      <% end %>
    </article>
  </div>
</section>