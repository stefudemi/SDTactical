<section class="admin-shell"><div class="container">
  <div class="admin-header"><div><p class="eyebrow">Usuario #<%= @user.id %></p><h1><%= @user.name.presence || "Usuario sin nombre" %></h1></div><div class="admin-actions"><%= link_to "Editar", edit_admin_user_path(@user), class: "btn btn-primary" %><%= link_to "Volver", admin_users_path, class: "btn btn-secondary" %></div></div>
  <article class="admin-card"><dl class="admin-details"><dt>Nombre</dt><dd><%= @user.name.presence || "—" %></dd><dt>Email</dt><dd><%= @user.email.presence || "—" %></dd><dt>Administrador</dt><dd><%= @user.admin? ? "Sí" : "No" %></dd></dl></article>
  <article class="admin-card"><h2>Pedidos del usuario</h2><% if @orders.any? %><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>ID</th><th>Estado</th><th>Total</th><th></th></tr></thead><tbody><% @orders.each do |order| %><tr><td>#<%= order.id %></td><td><%= order.status.presence || "—" %></td><td><%= number_to_currency(order.total, unit: "$", separator: ",", delimiter: ".") %></td><td><%= link_to "Ver", admin_order_path(order) %></td></tr><% end %></tbody></table></div><% else %><p class="empty-state">Este usuario todavía no tiene pedidos.</p><% end %></article>
</div></section>
