<section class="hero-section">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Preparación, precisión y rendimiento</p>
      <h1>Equipamiento táctico para cada escenario.</h1>
      <p class="hero-text">
        En SDTactical reunimos accesorios, replicas y complementos para jugadores que buscan
        desempeño, estilo y confiabilidad en cada salida.
      </p>

      <div class="hero-actions">
        <%= link_to "Explorar productos", products_path, class: "btn btn-primary" %>
        <%= link_to "Ver categorías", "#categorias", class: "btn btn-secondary" %>
      </div>

      <ul class="hero-metrics" aria-label="Estadísticas de la tienda">
        <li>
          <strong>+4.000</strong>
          <span>equipos vendidos</span>
        </li>
        <li>
          <strong>48h</strong>
          <span>envío rápido</span>
        </li>
        <li>
          <strong>24/7</strong>
          <span>soporte técnico</span>
        </li>
      </ul>
    </div>

    <div class="hero-visual" aria-label="Vista destacada de productos">
      <div class="visual-card">
        <div class="visual-badge">Airsoft premium</div>
        <div class="visual-product">
          <div class="visual-product__glow"></div>
          <div class="visual-product__body"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="categorias" class="section section-light">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">Categorías</p>
      <h2>Especialización en cada disciplina.</h2>
    </div>

    <div class="category-grid">
      <article class="category-card">
        <span class="category-card__icon">R</span>
        <h3>Rifles</h3>
        <p>Precision rifles, replicas de alto rendimiento y accesorios.</p>
      </article>
      <article class="category-card">
        <span class="category-card__icon">P</span>
        <h3>Pistolas</h3>
        <p>Armas de apoyo, compactas y de respuesta rápida.</p>
      </article>
      <article class="category-card">
        <span class="category-card__icon">A</span>
        <h3>Accesorios</h3>
        <p>Visores, grips, mochilas y piezas para personalizar.</p>
      </article>
      <article class="category-card">
        <span class="category-card__icon">E</span>
        <h3>Equipo</h3>
        <p>Protección, carga y equipamiento para campo y entrenamiento.</p>
      </article>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="feature-strip">
      <div class="feature-item">
        <span class="feature-item__label">01</span>
        <div>
          <h3>Selección profesional</h3>
          <p>Productos pensados para uso serio y exigente.</p>
        </div>
      </div>
      <div class="feature-item">
        <span class="feature-item__label">02</span>
        <div>
          <h3>Envío ágil</h3>
          <p>Recibí tu pedido con rapidez y seguimiento.</p>
        </div>
      </div>
      <div class="feature-item">
        <span class="feature-item__label">03</span>
        <div>
          <h3>Soporte experto</h3>
          <p>Asesoramiento para elegir el mejor equipo.</p>
        </div>
      </div>
    </div>
  </div>
</section>
