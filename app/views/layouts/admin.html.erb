<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Administración | SDTactical" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="admin-body">
    <header class="topbar">
      <div class="container topbar__inner">
        <%= link_to admin_root_path, class: "brand" do %>
          <span class="brand__mark">SD</span>
          <span class="brand__text">SDTactical <span class="brand__badge">Admin</span></span>
        <% end %>

        <nav class="admin-menu" aria-label="Administración">
          <%= link_to "Panel", admin_root_path, class: ("is-active" if current_page?(admin_root_path)) %>
          <%= link_to "Productos", admin_products_path, class: ("is-active" if controller_name == "products") %>
          <%= link_to "Categorías", admin_categories_path, class: ("is-active" if controller_name == "categories") %>
          <%= link_to "Pedidos", admin_orders_path, class: ("is-active" if controller_name == "orders") %>
          <%= link_to "Usuarios", admin_users_path, class: ("is-active" if controller_name == "users") %>
        </nav>

        <div class="admin-session">
          <%= link_to "Ver tienda", root_path, class: "admin-link" %>
          <%= button_to "Cerrar sesión", logout_path, method: :delete, class: "btn btn-secondary btn-sm", form: { class: "inline-form" } %>
        </div>
      </div>
    </header>

    <% flash.each do |type, message| %>
      <div class="container">
        <p role="status" class="flash <%= "flash--alert" if type.to_s == "alert" %>"><%= message %></p>
      </div>
    <% end %>

    <main><%= yield %></main>
  </body>
</html>
