<h1>Pedido confirmado</h1>
<p>Hola <%= @order.user.name %>, recibimos tu pedido #<%= @order.id %>.</p>
<ul>
  <% @order.order_items.each do |item| %>
    <li><%= item.quantity %> × <%= item.product.name %> (<%= number_to_currency(item.unit_price) %>)</li>
  <% end %>
</ul>
<p>Total: <%= number_to_currency(@order.total) %></p>