<h1>Iniciar sesión</h1>

<% if flash[:alert].present? %>
  <p class="admin-errors"><%= flash[:alert] %></p>
<% end %>

<%= form_with url: login_path do |form| %>
  <div>
    <%= form.label :email %>
    <%= form.email_field :email, required: true, autocomplete: "email" %>
  </div>
  <div>
    <%= form.label :password, "Contraseña" %>
    <%= form.password_field :password, required: true, autocomplete: "current-password" %>
  </div>
  <%= form.submit "Ingresar" %>
<% end %>

<p>¿Todavía no tenés cuenta? <%= link_to "Crear una cuenta", signup_path %></p>
